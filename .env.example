# Copy this file to .env and fill in values. Never commit .env (it is in .gitignore).
# Restart `npx expo start` after changing .env — Expo reads it only when it starts.
#
# Stage 11 — Supabase (dashboard → your project → Connect, or Project Settings → API Keys):
# the Project URL, and the PUBLISHABLE key (sb_publishable_…) or the legacy "anon" key.
# Both are safe inside the app: Row Level Security decides what they can do.
# NEVER put the secret / service_role key here or anywhere in the app — the app refuses it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
