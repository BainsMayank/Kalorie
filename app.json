{
  "expo": {
    "name": "Kalorie",
    "slug": "kalorie",
    "scheme": "kalorie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mynklabs.kalorie"
    },
    "android": {
      "package": "com.mynklabs.kalorie",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "expo-asset",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Kalorie uses the camera to read barcodes on food packets and to photograph nutrition labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalorie opens your photos only when you pick a photo of a barcode or a nutrition label.",
          "cameraPermission": "Kalorie uses the camera to read barcodes on food packets and to photograph nutrition labels.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "contactEmail": ""
    }
  }
}
